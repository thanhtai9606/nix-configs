{ pkgs, config, ... }:

let
  wallpaperDir = ./assets/wallpapers;
  defaultWallpaper = "${wallpaperDir}/alpine-lake.jpg";

  terminal = "${config.programs.alacritty.package}/bin/alacritty";
  noctalia = "${pkgs.noctalia}/bin/noctalia";

  # Super+0 power menu (fuzzel dmenu → noctalia session / niri quit)
  powerMenu = pkgs.writeShellScriptBin "nemo-power-menu" ''
    set -euo pipefail
    choice="$(printf 'lock\nsuspend\nexit\nreboot\npoweroff' \
      | ${pkgs.fuzzel}/bin/fuzzel -d -p power)"
    case "$choice" in
      lock) exec ${noctalia} msg session lock ;;
      suspend) exec ${noctalia} msg session suspend ;;
      exit) exec ${pkgs.niri}/bin/niri msg action quit --skip-confirmation ;;
      reboot) exec ${noctalia} msg session reboot ;;
      poweroff) exec ${noctalia} msg session shutdown ;;
    esac
  '';

  screenshotRegion = pkgs.writeShellScriptBin "nemo-screenshot-region" ''
    set -euo pipefail
    ${pkgs.grim}/bin/grim -g "$(${pkgs.slurp}/bin/slurp)" - \
      | ${pkgs.swappy}/bin/swappy -f -
  '';
in
{
  home.file."Pictures/Wallpapers".source = wallpaperDir;

  home.packages = with pkgs; [
    brightnessctl
    playerctl
    pamixer
    jq
    networkmanagerapplet
    swaybg
    xwayland-satellite
    powerMenu
    screenshotRegion
  ];

  # Declarative niri config (KDL). Validated at runtime by niri.
  xdg.configFile."niri/config.kdl".text = ''
    // Generated by Home Manager — home-manager/niri.nix

    input {
      keyboard {
        xkb {
          layout "us"
        }
        repeat-delay 300
        repeat-rate 50
      }

      touchpad {
        tap
        tap-button-map "left-right-middle"
        click-method "clickfinger"
        natural-scroll
        dwt
        dwtp
        accel-profile "adaptive"
        accel-speed 0.3
        scroll-method "two-finger"
        middle-emulation
      }

      focus-follows-mouse max-scroll-amount="0%"
    }

    layout {
      gaps 4
      center-focused-column "never"
      default-column-width { proportion 0.5; }

      focus-ring {
        width 2
        active-color "#89b4fa"
        inactive-color "#313244"
      }

      border {
        off
      }
    }

    prefer-no-csd

    screenshot-path "~/Pictures/Screenshots/Screenshot from %Y-%m-%d %H-%M-%S.png"

    spawn-at-startup "swaybg" "-m" "fill" "-i" "${defaultWallpaper}"
    spawn-at-startup "${noctalia}"
    spawn-at-startup "nm-applet" "--indicator"
    spawn-at-startup "${pkgs.blueman}/bin/blueman-applet"

    hotkey-overlay {
      skip-at-startup
    }

    window-rule {
      match app-id=r#"firefox$"# title="^Picture-in-Picture$"
      open-floating true
    }

    binds {
      Mod+Shift+Slash { show-hotkey-overlay; }

      // Launchers / basics (Sway muscle memory)
      Mod+Return hotkey-overlay-title="Terminal" { spawn "${terminal}"; }
      Mod+D hotkey-overlay-title="App launcher" { spawn-sh "${noctalia} msg panel-toggle launcher"; }
      Ctrl+Alt+Return hotkey-overlay-title="Terminal (VM)" { spawn "${terminal}"; }
      Ctrl+Alt+D hotkey-overlay-title="Launcher (VM)" { spawn-sh "${noctalia} msg panel-toggle launcher"; }
      Mod+Tab hotkey-overlay-title="Window switcher" { spawn-sh "${noctalia} msg window-switcher"; }
      Mod+Shift+D { spawn-sh "${noctalia} msg panel-open launcher"; }
      Mod+Shift+Q repeat=false { close-window; }
      Mod+0 hotkey-overlay-title="Power menu" { spawn "${powerMenu}/bin/nemo-power-menu"; }
      Mod+Shift+E { quit; }
      Ctrl+Alt+Delete { quit; }

      // Focus (columns / windows)
      Mod+H { focus-column-left; }
      Mod+J { focus-window-down; }
      Mod+K { focus-window-up; }
      Mod+L { focus-column-right; }
      Mod+Left { focus-column-left; }
      Mod+Down { focus-window-down; }
      Mod+Up { focus-window-up; }
      Mod+Right { focus-column-right; }

      // Move (Sway-like Mod+Shift)
      Mod+Shift+H { move-column-left; }
      Mod+Shift+J { move-window-down; }
      Mod+Shift+K { move-window-up; }
      Mod+Shift+L { move-column-right; }

      // Layout
      Mod+F { fullscreen-window; }
      Mod+M { maximize-column; }
      Mod+C { center-column; }
      Mod+R { switch-preset-column-width; }
      Mod+W { toggle-column-tabbed-display; }
      Mod+V { toggle-window-floating; }
      Mod+Shift+Space { toggle-window-floating; }
      Mod+Space { switch-focus-between-floating-and-tiling; }
      Mod+O repeat=false { toggle-overview; }
      Mod+Comma { consume-window-into-column; }
      Mod+Period { expel-window-from-column; }
      Mod+BracketLeft { consume-or-expel-window-left; }
      Mod+BracketRight { consume-or-expel-window-right; }
      Mod+Minus { set-column-width "-10%"; }
      Mod+Equal { set-column-width "+10%"; }

      // Workspaces 1–9
      Mod+1 { focus-workspace 1; }
      Mod+2 { focus-workspace 2; }
      Mod+3 { focus-workspace 3; }
      Mod+4 { focus-workspace 4; }
      Mod+5 { focus-workspace 5; }
      Mod+6 { focus-workspace 6; }
      Mod+7 { focus-workspace 7; }
      Mod+8 { focus-workspace 8; }
      Mod+9 { focus-workspace 9; }

      Mod+Shift+1 { move-column-to-workspace 1; }
      Mod+Shift+2 { move-column-to-workspace 2; }
      Mod+Shift+3 { move-column-to-workspace 3; }
      Mod+Shift+4 { move-column-to-workspace 4; }
      Mod+Shift+5 { move-column-to-workspace 5; }
      Mod+Shift+6 { move-column-to-workspace 6; }
      Mod+Shift+7 { move-column-to-workspace 7; }
      Mod+Shift+8 { move-column-to-workspace 8; }
      Mod+Shift+9 { move-column-to-workspace 9; }

      Mod+Page_Down { focus-workspace-down; }
      Mod+Page_Up { focus-workspace-up; }
      Mod+U { focus-workspace-down; }
      Mod+I { focus-workspace-up; }

      Mod+WheelScrollDown cooldown-ms=150 { focus-workspace-down; }
      Mod+WheelScrollUp cooldown-ms=150 { focus-workspace-up; }

      // Screenshots (grim → swappy) + niri built-ins
      Print { spawn "${screenshotRegion}/bin/nemo-screenshot-region"; }
      Mod+Shift+S { spawn "${screenshotRegion}/bin/nemo-screenshot-region"; }
      Ctrl+Print { screenshot-screen; }
      Alt+Print { screenshot-window; }

      // Displays
      Mod+Shift+P { spawn "${pkgs.wdisplays}/bin/wdisplays"; }
      Mod+Alt+P { spawn "nemo-display-toggle"; }

      // Media / brightness
      XF86AudioRaiseVolume allow-when-locked=true { spawn-sh "${pkgs.pamixer}/bin/pamixer -i 5"; }
      XF86AudioLowerVolume allow-when-locked=true { spawn-sh "${pkgs.pamixer}/bin/pamixer -d 5"; }
      XF86AudioMute allow-when-locked=true { spawn-sh "${pkgs.pamixer}/bin/pamixer -t"; }
      XF86AudioMicMute allow-when-locked=true { spawn-sh "${pkgs.pamixer}/bin/pamixer --default-source -t"; }
      XF86MonBrightnessUp allow-when-locked=true { spawn "${pkgs.brightnessctl}/bin/brightnessctl" "set" "+5%"; }
      XF86MonBrightnessDown allow-when-locked=true { spawn "${pkgs.brightnessctl}/bin/brightnessctl" "set" "5%-"; }
      XF86AudioPlay allow-when-locked=true { spawn "${pkgs.playerctl}/bin/playerctl" "play-pause"; }
      XF86AudioNext allow-when-locked=true { spawn "${pkgs.playerctl}/bin/playerctl" "next"; }
      XF86AudioPrev allow-when-locked=true { spawn "${pkgs.playerctl}/bin/playerctl" "previous"; }

      Mod+Escape allow-inhibiting=false { toggle-keyboard-shortcuts-inhibit; }
      Mod+Shift+Ctrl+P { power-off-monitors; }
    }
  '';
}
